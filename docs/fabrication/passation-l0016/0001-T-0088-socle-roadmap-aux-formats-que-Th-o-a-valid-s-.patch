+    """Un texte, ses identifiants écrits `X-NNNN`, comme le guide les montre :
+    il ne cite aucun identifiant d'une mémoire."""
+    return memoire.ID_RE.sub(lambda m: f"{m.group('type')}-NNNN", texte)
