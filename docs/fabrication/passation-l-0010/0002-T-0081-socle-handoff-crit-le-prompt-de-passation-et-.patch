+        git(self.partante, "push", "-q", "origin", "travail")
+        git(neuve, "fetch", "-q", "origin")
+        code, sortie, erreur = self.lancer(neuve, *garde.split()[3:])
+        self.assertEqual((code, sortie), (1, ""))
