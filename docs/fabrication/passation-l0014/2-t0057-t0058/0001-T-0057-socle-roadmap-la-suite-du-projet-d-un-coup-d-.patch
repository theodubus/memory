+        self.assertEqual(g.attendus("L-0002"), {"L-0001", "L-0003"})
+        self.assertEqual((g.deps("L-0002"), g.attend("L-0002"), g.ou_en_est("L-0003")), (["L-0001"], ["L-0001"], "pret"))
+        self.assertTrue(g.ouvert("L-0001"))
